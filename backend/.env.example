# Copy to backend/.env and adjust:  cp .env.example .env
# Every value is validated at startup; an invalid value stops the API with a clear error.

# mock  -> deterministic SYNTHETIC results for integration testing (no model is loaded)
# gemma -> Gemma 3 270M IT base model + severity LoRA adapter (Transformers + PEFT)
# There is no automatic fallback between providers.
INFERENCE_PROVIDER=mock

# Public name of the base model (shown in the API/UI).
MODEL_ID=google/gemma-3-270m-it
# The base model weights ship with this project; loaded offline from here.
# Leave empty to download MODEL_ID from Hugging Face instead.
BASE_MODEL_PATH=models/gemma3-270m-severity/base

# The fine-tuned severity LoRA adapter (also shipped in backend/models/).
# Relative paths resolve against ADAPTER_BASE_DIR, or (if empty) against backend/.
# To use the training repo's copy instead:
#   ADAPTER_PATH=outputs/gemma3-270m-severity-lora/best_adapter
#   ADAPTER_BASE_DIR=~/AI-Lab/incident_triage_dataset_v3
ADAPTER_PATH=models/gemma3-270m-severity/adapter
ADAPTER_BASE_DIR=

# auto | cpu | mps | cuda   (auto = cuda -> mps -> cpu)
DEVICE=auto
MAX_NEW_TOKENS=32

# Comma-separated list of allowed browser origins (CORS)
FRONTEND_ORIGIN=http://localhost:3000

LOG_LEVEL=INFO
# Artificial delay for the mock provider so loading states are visible in the UI
MOCK_LATENCY_MS=400
# Max results kept in memory for GET /api/v1/triage/{request_id} (lost on restart)
HISTORY_SIZE=200
# Local ticket queue (JSONL: ticket_id, title, description, expected_severity).
# Relative paths resolve against backend/.
TICKETS_PATH=data/tickets.jsonl
